{
  "name": "myst-listing",
  "version": "0.1.0",
  "main": "dist/plugin.mjs",
  "type": "module",
  "license": "MIT",
  "description": "Collect items and display them as tables, galleries, summaries, or feeds.",
  "private": true,
  "devDependencies": {
    "@types/node": "^22.10.5",
    "esbuild": "0.25.4",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "build": "esbuild src/plugin.ts --bundle --outfile=dist/plugin.mjs --platform=node --format=esm",
    "build:docs": "npm run build && cd docs && npx mystmd build --html",
    "test": "npm run build:docs && vitest run"
  },
  "dependencies": {
    "glob": "^11.0.2",
    "js-yaml": "^4.1.0",
    "myst-common": "^1.7.11",
    "myst-transforms": "^1.3.34"
  }
}
